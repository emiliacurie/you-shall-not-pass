{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "branch",
      "command",
      "expected"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "branch": {
        "enum": [
          "main",
          "feature/test"
        ]
      },
      "command": {
        "type": "string",
        "minLength": 1
      },
      "expected": {
        "enum": [
          "allow",
          "deny",
          "require_scoped_approval"
        ]
      }
    }
  }
}
